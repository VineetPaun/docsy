# Docsy environment — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# ⚠️ Four more variables live on the *Convex deployment*, not in this file.
# Convex functions do not read .env.local. See the block at the bottom.
#
# Each entry below says what breaks without it. Most failures are silent, which
# is why the list is exhaustive rather than minimal (AUDIT.md §0.5).

# ── Required: nothing works without these ────────────────────────────────────

# Convex deployment URL, e.g. https://your-deployment.convex.cloud
# Ships to the browser by design. Without it: no data layer at all.
NEXT_PUBLIC_CONVEX_URL=

# Written by `bunx convex dev`. Used by the Convex CLI, not by app code.
CONVEX_DEPLOYMENT=

# Clerk keys, from the Clerk Dashboard → API Keys.
# `bun run build` cannot finish prerendering without the publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Required for chat ────────────────────────────────────────────────────────

# OpenRouter gateway key. Also fronts the model catalogue served to the picker.
# Without it: /api/chat and /api/research return 503 naming this variable.
OPENROUTER_API_KEY=

# ── Retrieval: chat does not work without these ──────────────────────────────

# Gemini embeddings (gemini-embedding-001, 768 dims). GEMINI_API_KEY also works;
# GOOGLE_API_KEY is checked first.
# Without it: /api/chat returns 503 naming this variable. Retrieval is the only
# path from a source to the prompt — there is no raw-text fallback any more.
GOOGLE_API_KEY=

# Qdrant vector store. Defaults to http://localhost:6333 if unset.
# API key is optional for a local instance, required for Qdrant Cloud.
# Without QDRANT_URL: /api/chat returns 503 naming it.
QDRANT_URL=
QDRANT_API_KEY=

# ── Optional features ───────────────────────────────────────────────────────

# ElevenLabs text-to-speech for audio overviews.
# Without the key: an overview produces a script and no audio.
ELEVENLABS_API_KEY=
# Defaults to Rachel (21m00Tcm4TlvDq8ikWAM).
ELEVENLABS_VOICE_ID=

# Web search. Tavily is tried first, Serper is the fallback.
# Without both: /api/web-search and /api/research return 503.
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Cosmetic ────────────────────────────────────────────────────────────────

# Sent to OpenRouter as the attribution referrer. Defaults to localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# NOT part of this file — set these on the Convex deployment instead:
#
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev
#   bunx convex env set CLERK_WEBHOOK_SECRET whsec_...
#   bunx convex env set QDRANT_URL https://...
#   bunx convex env set QDRANT_API_KEY ...
#
# Plus, in the Clerk Dashboard:
#   • a JWT template named exactly `convex` (convex/auth.config.ts pins
#     applicationID: "convex"; a differently-named template reads as anonymous)
#   • a webhook at https://<deployment>.convex.site/clerk-webhook — note .site,
#     not .cloud — subscribed to user.created / user.updated / user.deleted
#
# Failure modes, all silent and all different:
#   CLERK_JWT_ISSUER_DOMAIN missing → every query empty, every mutation
#     "Unauthenticated". Looks like being logged out
#   `convex` JWT template missing  → the same, plus /api/search, /api/embeddings,
#     /api/chat and /api/audio-overview all 403 (they fail closed)
#   webhook not registered         → no `users` row is ever created, so every
#     mutation throws "User not provisioned". New signups cannot use the app
#   QDRANT_URL missing on Convex   → deletes look fine, vectors survive, and
#     deleted documents keep coming back as citations
#
# AUDIT.md §3.1 has the same table with more detail.
# ─────────────────────────────────────────────────────────────────────────────
