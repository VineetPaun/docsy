# Docsy environment template — copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# ⚠️ Missing keys do NOT raise errors. The app silently falls back to
# degraded output rather than an error, so a broken setup can look like a
# working one. Chat, web search and research are the exception — they now
# return 503 and name the variable they are missing.
# If output seems oddly generic, check this file before debugging logic.
#
# One variable does NOT belong here: CLERK_JWT_ISSUER_DOMAIN is read by
# Convex functions, not by Next.js, so it must be set on the Convex
# deployment itself — see the bottom of this file.

# ── Convex (required — the app is non-functional without it) ──────────────
# Both are written by `bunx convex dev` on first run.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ── Clerk auth (required) ─────────────────────────────────────────────────
# Dashboard → API keys. `bun run build` cannot finish without the publishable
# key, because prerendering /_not-found initialises the Clerk SDK.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── LLM gateway (required for real chat) ──────────────────────────────────
# Absent → /api/chat and /api/research return 503 naming this variable.
OPENROUTER_API_KEY=
# Sent to OpenRouter for attribution only. Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Embeddings (required for RAG) ─────────────────────────────────────────
# Either one works; GOOGLE_API_KEY is checked first. Absent → no vectors are
# written and chat answers from raw document text instead of retrieval.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ── Qdrant vector store (required for RAG) ────────────────────────────────
# Defaults to http://localhost:6333. API key is optional for a local instance,
# required for Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Audio overviews (optional) ────────────────────────────────────────────
# Absent → the podcast script is still generated, just with no audio.
ELEVENLABS_API_KEY=
# Defaults to Rachel (21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=

# ── Web search (optional) ─────────────────────────────────────────────────
# Tavily is tried first, Serper is the fallback. With neither, /api/web-search
# returns fabricated results rather than an error.
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Set on the Convex deployment, NOT here ────────────────────────────────
# Convex functions read their own environment, so these four go on the
# deployment. Each fails silently and differently — AUDIT.md §3.1 has the
# symptom table.
#
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev
#   bunx convex env set CLERK_WEBHOOK_SECRET whsec_...
#   bunx convex env set QDRANT_URL https://...
#   bunx convex env set QDRANT_API_KEY ...
#
# CLERK_JWT_ISSUER_DOMAIN — without it every ctx.auth.getUserIdentity() is
#   null: queries return empty, mutations throw "Unauthenticated". Looks like a
#   broken app, not a missing variable. Must match a Clerk JWT template named
#   exactly `convex` (convex/auth.config.ts pins applicationID: "convex").
#   lib/convex-server.ts uses that same template for API-route ownership checks
#   and fails closed — no template means every search/embed/chat returns 403.
#
# CLERK_WEBHOOK_SECRET — convex/http.ts is the ONLY thing that creates `users`
#   rows. Without the secret (or without the endpoint registered in the Clerk
#   Dashboard at https://<deployment>.convex.site/clerk-webhook — note .site,
#   not .cloud) new signups cannot use the app: every mutation throws
#   "User not provisioned".
#
# QDRANT_URL / QDRANT_API_KEY — yes, again: the copies above are for Next.js,
#   these are for the delete cascade running inside Convex. Without them
#   deletes appear to succeed while the vectors survive, and deleted documents
#   keep coming back as chat citations.
